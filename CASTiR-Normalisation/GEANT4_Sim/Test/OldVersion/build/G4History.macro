/run/verbose 0
/process/verbose 0
/physic/addPhysics standard_opt4
/physic/addPhysics optical_physics
/process/eLoss/binsDEDX 480
/process/eLoss/binsLambda 480
/run/initialize
/physic/setGCut 4.5 mm
/physic/setPCut 0.16 mm
/physic/setECut 0.16 mm
/primaryGenerator/setFixedEnergyFlag true
/primaryGenerator/setEnergy 0.1 keV
/userRun/setOutFileName ./test.root
/run/beamOn 200000
/run/beamOn 1000
/control/execute macro/vis.mac
/vis/open OGL
/vis/sceneHandler/create OGL
/vis/viewer/create ! ! 600
/vis/viewer/refresh
/vis/viewer/set/viewpointThetaPhi 90 90 deg
/vis/viewer/zoom 30
/vis/viewer/set/auxiliaryEdge true
/vis/viewer/set/edge
/vis/viewer/set/style surface
/vis/scene/add/volume
/vis/drawVolume pvWorld
/vis/scene/create
/vis/scene/add/volume pvWorld -1 -1 none m 0 0 0 0 0 0
/vis/sceneHandler/attach
/vis/scene/add/axes 10 10 0 5 cm
/vis/scene/notifyHandlers
/vis/scene/add/trajectories
/tracking/storeTrajectory 1
/vis/scene/notifyHandlers
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e+ red
/vis/scene/notifyHandlers scene-0
/vis/scene/endOfEventAction accumulate 3
